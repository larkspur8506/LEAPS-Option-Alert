# 请复制此文件为 .env 并填入真实的配置值
# cp .env.example .env

# 企业微信 Webhook URL（从企业微信群机器人设置中获取）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key_here

# ---------------------------------------------------------------------------
# 管理员与初始化 (P0 安全)
# ---------------------------------------------------------------------------
# 管理员口令在首次访问 /setup 时设置, 存储为 scrypt 加盐散列 (不在此处配置)。
#
# 初始化口令: 首次部署务必设置。配置后 /setup 必须带 ?token=<该值> 才能访问;
# 未配置时仅允许本机 127.0.0.1 访问, 公网 /setup 一律 403。
SETUP_TOKEN=change_me_before_first_deploy

# 会话签名密钥: 留空则自动生成并写入 data/.session_secret (0600, 随数据卷持久化)。
# 多副本/多 worker 部署必须显式设置同一个值, 否则会话不互通。
SESSION_SECRET=

# 管理员会话有效期 (小时)
SESSION_MAX_AGE_HOURS=168

# HTTPS 部署置 true (为会话 Cookie 增加 Secure 标记); 内网 http 访问保持 false
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# QQQ LEAPS 策略参数 (后台「规则配置」页可覆盖这些默认值)
# ---------------------------------------------------------------------------
# 入场信号阈值 (RSI14 低于该值视为超卖; 按最后一根已收盘日 K 判定)
RSI_THRESHOLD=35.0

# 止盈: RSI14 高于该值 -> 提醒全部清仓 (回测: 65 最稳, 70 期望更高但尾部更深)
LEAPS_TP_RSI=65.0

# 时间止损: 持仓超过该交易日数且未回本 -> 提醒平仓 (回测定稿 126)
LEAPS_TIME_STOP_TRADING_DAYS=126

# DTE 强制平仓: 距到期不足该自然日数 -> 强制清仓提醒 (早期版本沿用值 180)
LEAPS_DTE_FORCE_DAYS=180

# 加仓档位: 相对信号基准回撤比例 (逗号分隔), 且 RSI 仍低于入场阈值时提醒加仓
LEAPS_ADD_LEVELS=0.10,0.20

# 单信号最大张数 (含首张)
LEAPS_MAX_QUANTITY=3

# 建议合约参数: Delta 与期限 (自然日, 约 2 年 = 730)
LEAPS_TARGET_DELTA=0.65
LEAPS_TARGET_TENOR_DAYS=730

# WAITING 建议存活期 (交易日): 超期自动标记 EXPIRED 并释放信号闸门; 0 表示不过期
WAITING_TTL_TRADING_DAYS=3

# ---------------------------------------------------------------------------
# 日报与数据保留
# ---------------------------------------------------------------------------
# 每日 16:30 (美东) 日报模式 (off / leaps)
DAILY_REPORT_MODE=leaps

# 告警日志保留天数
ALERT_LOG_RETENTION_DAYS=90

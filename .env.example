# 请复制此文件为 .env 并填入真实的配置值
# cp .env.example .env

# 企业微信 Webhook URL（从企业微信群机器人设置中获取）
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_webhook_key_here

# ---------------------------------------------------------------------------
# 管理员与初始化 (P0 安全)
# ---------------------------------------------------------------------------
# 管理员口令在首次访问 /setup 时设置, 存储为 scrypt 加盐散列 (不在此处配置)。
#
# 初始化口令: 首次部署务必设置。配置后 /setup 必须带 ?token=<该值> 才能访问;
# 未配置时仅允许本机 127.0.0.1 访问, 公网 /setup 一律 403。
SETUP_TOKEN=change_me_before_first_deploy

# 会话签名密钥: 留空则自动生成并写入 data/.session_secret (0600, 随数据卷持久化)。
# 多副本/多 worker 部署必须显式设置同一个值, 否则会话不互通。
SESSION_SECRET=

# 管理员会话有效期 (小时)
SESSION_MAX_AGE_HOURS=168

# HTTPS 部署置 true (为会话 Cookie 增加 Secure 标记); 内网 http 访问保持 false
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# NDX Grid 策略参数
# ---------------------------------------------------------------------------
# 开仓信号阈值 (RSI14 低于该值视为超卖; 按最后一根已收盘日 K 判定)
RSI_THRESHOLD=35.0

# 建议网格默认参数 (Base 的上下幅度 / 格数 / 建议杠杆)
# 注意: 每格价格幅度 = (Upper - Lower) * Base / 格数, 关系到"一格毛利能否覆盖手续费"
DEFAULT_GRID_UPPER_PCT=0.20
DEFAULT_GRID_LOWER_PCT=0.20
DEFAULT_GRID_COUNT=200
DEFAULT_GRID_LEVERAGE=5.0

# Grid 跌破 Lower 后继续下跌多少比例触发止损提醒 (仅提醒, 不改变 Grid 状态)
# 止损提醒线 = Lower × (1 - 该比例), 例: 0.10 -> Lower × 0.90
DEFAULT_GRID_STOP_LOSS_AFTER_LOWER_PCT=0.10

# WAITING 建议存活期 (交易日): 超期自动标记 EXPIRED 并释放信号闸门; 0 表示不过期
WAITING_TTL_TRADING_DAYS=3

# ---------------------------------------------------------------------------
# 交易所成本 (仅用于页面/日报的风险速算展示, 不参与任何判定)
# ---------------------------------------------------------------------------
# 手续费单位 %, 单边。往返成本 = (maker 或 taker 中较大者) × 2
# 例: MEXC 合约 0 手续费 -> 都填 0; 普通 0.05% 单边 -> 填 0.05
GRID_MAKER_FEE_PCT=0.0
GRID_TAKER_FEE_PCT=0.0

# 资金费: 每 8 小时费率 %, 正数=多头付费。用于估算持仓拖累 (日 = 3 × 该值)
FUNDING_RATE_PCT_8H=0.0

# ---------------------------------------------------------------------------
# 日报与数据保留
# ---------------------------------------------------------------------------
# 每日 16:30 (美东) 日报模式 (off / ndx_grid)
DAILY_REPORT_MODE=ndx_grid

# 告警日志保留天数
ALERT_LOG_RETENTION_DAYS=90
